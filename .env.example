# ---------------------------------------------------------------------------
# EcoSoap ERP - variables de entorno
#
# Copiar este archivo como .env en la raiz del repositorio y ajustar los
# valores. El archivo .env NUNCA se versiona: el repositorio es publico.
#
# Este unico archivo alimenta a las tres piezas del proyecto:
#   - docker-compose.yml lo lee para levantar PostgreSQL
#   - el backend lo carga mediante @nestjs/config
#   - Vite lo lee desde la raiz, pero solo inyecta en el navegador las
#     variables con prefijo VITE_, de modo que DATABASE_URL y la contrasena
#     de PostgreSQL nunca llegan al cliente.
# ---------------------------------------------------------------------------

# --- PostgreSQL (contenedor de docker-compose) ---
# El puerto es 5433 y no el 5432 habitual a proposito: es frecuente tener una
# instalacion nativa de PostgreSQL en la maquina ocupando el 5432, y en ese caso
# las conexiones irian a esa instancia en lugar de al contenedor, produciendo un
# confuso error 28000 "no existe el rol ecosoap". Usar 5433 evita el choque sin
# obligar a nadie a desinstalar su PostgreSQL local.
POSTGRES_USER=ecosoap
POSTGRES_PASSWORD=ecosoap_dev_password
POSTGRES_DB=ecosoap_erp
POSTGRES_PORT=5433

# --- Backend (NestJS) ---
# El usuario, contrasena, puerto y base deben coincidir con los valores de arriba.
DATABASE_URL=postgresql://ecosoap:ecosoap_dev_password@localhost:5433/ecosoap_erp?schema=public
NODE_ENV=development
PORT=3000
FRONTEND_URL=http://localhost:5173

# --- Frontend (Vite) ---
VITE_API_URL=http://localhost:3000/api
